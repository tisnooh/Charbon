# .env.production — EXEMPLE (copier vers .env.production, JAMAIS committer)
# Utilisé par docker-compose (env_file). Validation zod stricte au boot :
# valeur manquante/invalide = refus de démarrer avec message précis.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Volume Docker nommé (compose) — ne pas changer sans migrer les données :
DB_PATH=/data/charbon.db
SESSION_TTL_DAYS=30

# URLs publiques RÉELLES (remplacer charbon.example par votre domaine)
APP_BASE_URL=https://charbon.example/app
SITE_BASE_URL=https://charbon.example
# Vide en mode A ; en mode B : https://app.charbon.example,https://www.charbon.example
CORS_ORIGINS=
# Cookie de session : laisser vide en mode A ; mode B : .charbon.example
COOKIE_DOMAIN=

# Sécurité / comportement
DEV_BILLING=false
SERVE_STATIC=true
RATE_LIMIT_AUTH_MAX=10

# E-mails transactionnels (provider au choix : Infomaniak, OVH, Mailgun, Brevo…)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Charbon <noreply@charbon.example>

# Stripe — TEST MODE d'abord (sk_test_…), live ensuite (sk_live_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=

# Backups (script scripts/backup-db.mjs) : rétention en jours
BACKUP_RETENTION_DAYS=7
