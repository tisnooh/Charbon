# ─────────────────────────────────────────────────────────────
# CHARBON — variables d'environnement
# Copier ce fichier vers .env.local puis renseigner les valeurs.
# Ne jamais committer de secrets.
# ─────────────────────────────────────────────────────────────

# Supabase — clés projet (Settings → API).
# La clé anon est safe côté client ET serveur (RLS appliquée).
# La clé service_role ne doit JAMAIS être exposée au frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publique du site (canonical, OG, sitemap).
# Ex : https://charbon.app
NEXT_PUBLIC_SITE_URL=

# Email de support affiché sur /support (placeholder sinon).
# Ex : support@charbon.app
NEXT_PUBLIC_SUPPORT_EMAIL=
