# ==============================================================
# Charbon — variables d'environnement
# Copier ce fichier vers `.env` (racine du dépôt) et ajuster.
# AUCUN secret réel ne doit être commité (`.env` est gitignoré).
# Toutes les variables ont une valeur par défaut fonctionnelle
# en développement : le projet démarre avec un `.env` vide.
# ==============================================================

# --- Serveur ---
# development | production
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Chemin du fichier base de données (relatif au cwd du processus API).
DB_PATH=data/charbon.db
# Durée de vie des sessions (jours)
SESSION_TTL_DAYS=30

# --- URLs publiques (utilisées dans les e-mails et le CORS) ---
# URL de l'application (PWA) — liens de réinitialisation de mot de passe
APP_BASE_URL=http://localhost:5173
# URL du site vitrine
SITE_BASE_URL=http://localhost:5174
# Origines CORS supplémentaires autorisées (séparées par des virgules)
CORS_ORIGINS=

# --- SMTP (optionnel) ---
# Sans SMTP configuré, un "dev outbox" stocke les e-mails en base
# (consultables via GET /api/v1/dev/emails, désactivé en production).
# En production, un vrai SMTP est requis pour les e-mails de reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Charbon <noreply@charbon.example>

# --- Facturation ---
# true (dev uniquement) : active le simulateur de paiement POST /subscription/upgrade
# pour tester le plan Premium sans prestataire. Ignoré/forcé à false en production.
DEV_BILLING=true

# --- Stripe (production, non implémenté en V1 — voir docs/PROJECT_STATE.md) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_MONTHLY=
