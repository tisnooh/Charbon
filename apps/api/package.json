{
  "name": "@charbon/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API Charbon — Fastify 5 + Drizzle ORM + libSQL (SQLite). Auth par sessions opaques, isolation stricte par utilisateur.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@charbon/shared": "*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "drizzle-kit": "^0.31.10"
  }
}
